<chart id="23">
  <P Name="name">Descent Throttle/MATLAB Function2</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">23</P>
  <P Name="ssIdHighWaterMark">16</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">-1</P>
  <P Name="chartFileNumber">1</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">descent_tilt_lqr</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">23</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function theta_throttle = descent_tilt_lqr(h, v_vertical, faz, T_nominal, n_engines, m_total, g, theta_max_deg)
    if faz ~= 3
        theta_throttle = 0;
        return;
    end

    T_max_toplam = n_engines * T_nominal;
    theta_max = deg2rad(theta_max_deg);

    theta_hover = acos(min(max(m_total*g/T_max_toplam, -1), 1));

    K_H = -0.2;
    K_V = -0.37986389;

    delta_theta = -(K_H*h + K_V*v_vertical);
    theta_throttle = theta_hover + delta_theta;

    theta_throttle = min(max(theta_throttle, 0), theta_max);

end</P>
      </eml>
    </state>
    <data SSID="5" name="theta_throttle">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="h">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
