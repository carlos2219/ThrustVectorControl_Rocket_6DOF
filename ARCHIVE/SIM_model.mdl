__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_81.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="81">
  <P Name="name">MATLAB Function</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">81</P>
  <P Name="ssIdHighWaterMark">10</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">5</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">MassInertiaModel</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">81</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [m, dIdt, I, r_cg_t, x_cg] = MassInertiaModel(t)
% Computes vehicle mass and inertia tensor as propellant burns
% Linear depletion model: mass decreases linearly during burn, then holds constant

%% --- Editable parameters ---
m_dry    = 0.8;    % kg, mass with no propellant (structure + avionics + empty motors)
m_prop   = 0.05;   % kg, total propellant mass (KNSB)
t_burn   = 20;     % s, burn duration (must match ThrustMixer)

Ixx_dry  = 0.002;  % kg*m^2, roll-axis inertia (about x_b, nose axis), empty
Iyy_dry  = 0.05;   % kg*m^2, pitch-axis inertia (about y_b), empty
Izz_dry  = 0.05;   % kg*m^2, yaw-axis inertia (about z_b), empty

% How much extra inertia the propellant mass contributes when full
% (rough approximation: propellant sits near the tail, contributes mostly to pitch/yaw)
Ixx_prop = 0.0002;
Iyy_prop = 0.01;
Izz_prop = 0.01;

% Axial CG travel, TBD PLACEHOLDERS pending Kruthick&apos;s measured values.
% Duplicated here (not read from rocket.x_cg_initial / rocket.x_cg_burnout in
% initFcn.m) to match this block&apos;s existing self-contained parameter style;
% see CLAUDE.md known gap on duplicate/inconsistent parameter sets.
% Convention: measured from nose tip, positive aft (matches rocket.cg in initFcn.m).
x_cg_initial = 0.50; % m, TBD PLACEHOLDER - CG at ignition (full propellant)
x_cg_burnout = 0.46; % m, TBD PLACEHOLDER - CG at burnout (empty), propellant is
                      % aft of dry CG so burnout CG moves forward (smaller x)

%% --- Mass as a function of time ---
if t &lt; t_burn
    frac_burned = t / t_burn;      % 0 at ignition, 1 at burnout
else
    frac_burned = 1;
end

m_remaining_prop = m_prop * (1 - frac_burned);
m = m_dry + m_remaining_prop;

%% --- Inertia as a function of remaining propellant ---
Ixx = Ixx_dry + Ixx_prop * (1 - frac_burned);
Iyy = Iyy_dry + Iyy_prop * (1 - frac_burned);
Izz = Izz_dry + Izz_prop * (1 - frac_burned);

I = [Ixx 0 0; 0 Iyy 0; 0 0 Izz];

%% --- dI/dt (derivative of inertia w.r.t. time) ---
if t &lt; t_burn
    dIxx_dt = -Ixx_prop / t_burn;
    dIyy_dt = -Iyy_prop / t_burn;
    dIzz_dt = -Izz_prop / t_burn;
else
    dIxx_dt = 0;
    dIyy_dt = 0;
    dIzz_dt = 0;
end

dIdt = [dIxx_dt 0 0; 0 dIyy_dt 0; 0 0 dIzz_dt];

%% --- Axial CG position as a function of remaining propellant ---
% frac_burned is the propellant mass fraction burned here (equals the time
% fraction because depletion above is linear in time); linear interpolation
% between x_cg_initial and x_cg_burnout is exact for this depletion model.
% r_cg_t is left as-is (pre-existing unassigned output, out of scope here).
x_cg = x_cg_initial + (x_cg_burnout - x_cg_initial) * frac_burned;

end
</P>
      </eml>
    </state>
    <data SSID="5" name="m">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="7" name="dIdt">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="I">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="8" name="r_cg_t">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="9" name="t">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="10" name="x_cg">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">81</P>
      <P Name="drawStyle">SMART</P>
      <slide>
        <P Name="sticky">BOTH_STICK</P>
      </slide>
      <P Name="executionOrder">1</P>
    </transition>
    <junction SSID="3">
      <P Name="position">[23.5747 49.5747 7]</P>
      <P Name="subviewer">81</P>
      <P Name="type">CONNECTIVE_JUNCTION</P>
    </junction>
  </Children>
</chart>

